{
  "schema": 1,
  "enable": true,
  "sta_interface": "",
  "hs_config_path": "linux_hotspot.json",
  "hotspot_config_path": "config/linux_hotspot.json",
  "nvs_file": "run/device_linux.nvs.json",
  "use_real_wifi_sta": 1,
  "protocol": {
    "protocol_version": 1,
    "tcp_port": 5935,
    "multicast_group": "224.0.2.1",
    "multicast_port": 5936,
    "mdns_type": "_tactile._tcp",
    "max_payload": 1024,
    "app_data_text_bytes": 512,
    "session_id_length": 8
  },
  "persistence_keys": [
    "wifi_creds",
    "host_candidates",
    "evlog"
  ]
}
