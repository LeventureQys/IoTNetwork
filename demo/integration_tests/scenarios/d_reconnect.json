{
  "schema": 1,
  "actions": [
    {
      "id": "d_fault",
      "target": "device",
      "after_event": "session_online",
      "delay_ms": 2000,
      "action": "inject_fault",
      "args": {
        "name": "sock_send_fail",
        "argument_json": "{\"skip\":0,\"count\":1000}"
      }
    },
    {
      "id": "d_restore",
      "target": "device",
      "after_event": "session_offline",
      "delay_ms": 500,
      "action": "inject_fault",
      "args": {
        "name": "sock_send_fail",
        "argument_json": "{\"skip\":0,\"count\":0}"
      }
    }
  ]
}
